{
  "name": "wikitext-fmt",
  "version": "0.2.2",
  "description": "A parser-assisted structural formatter for MediaWiki wikitext",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "mediawiki",
    "wikitext",
    "formatter",
    "pretty-printer",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkyEye-FAST/wikitext-fmt.git"
  },
  "bugs": {
    "url": "https://github.com/SkyEye-FAST/wikitext-fmt/issues"
  },
  "homepage": "https://github.com/SkyEye-FAST/wikitext-fmt#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "wikitext-fmt": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:all": "pnpm -r --sort build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "pnpm check:versions && pnpm build:all && node scripts/check-docs.mjs && pnpm check:core-package-content && pnpm typecheck:tests && pnpm --filter wikitext-formatter typecheck && pnpm --filter wikitext-formatter check:package-content && pnpm test:run && pnpm smoke",
    "check:core-package-content": "node scripts/check-core-package-content.mjs",
    "check:docs": "pnpm build && node scripts/check-docs.mjs",
    "check:release-metadata": "node scripts/prepare-release.mjs",
    "check:vscode-release-metadata": "node scripts/check-version-metadata.mjs --release vscode",
    "check:versions": "node scripts/check-version-metadata.mjs",
    "check:extension": "pnpm --filter wikitext-formatter test:extension",
    "check:vsix": "pnpm --filter wikitext-formatter test:vsix",
    "check:vscode-release": "pnpm --filter wikitext-formatter check:release",
    "smoke": "node dist/cli.js --help > /dev/null && node dist/cli.js --print-localization-aliases --localization-source builtin > /dev/null && node scripts/release-smoke.mjs",
    "release:smoke": "pnpm build && pnpm smoke",
    "benchmark": "pnpm build && node scripts/benchmark-structural.mjs",
    "benchmark:release": "pnpm build && node scripts/benchmark-structural.mjs --output benchmark-current-report.json > /dev/null && node scripts/compare-benchmark-baseline.mjs --report benchmark-current-report.json --baseline benchmarks/structural-baseline.json --output benchmark-comparison-report.json",
    "corpus:build": "node scripts/build-target-corpus.mjs",
    "localization:update": "node --experimental-strip-types scripts/update-mediawiki-aliases.ts",
    "corpus": "pnpm corpus:production && pnpm corpus:aggressive",
    "corpus:production": "pnpm build && node scripts/run-corpus.mjs tests/real-pages --profile production --min-template-coverage 100 --min-table-coverage 100 --output corpus-production-report.json",
    "corpus:aggressive": "node scripts/run-corpus.mjs tests/real-pages --profile aggressive --min-template-coverage 100 --min-table-coverage 100 --output corpus-aggressive-report.json"
  },
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "dependencies": {
    "fast-glob": "^3.3.3",
    "wikiparser-node": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
