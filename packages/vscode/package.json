{
  "activationEvents": [
    "onLanguage:wikitext",
    "onLanguage:mediawiki"
  ],
  "bugs": {
    "url": "https://github.com/SkyEye-FAST/wikitext-fmt/issues"
  },
  "categories": [
    "Formatters"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wikitext-fmt.formatDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "%command.formatDocument.title%"
      },
      {
        "command": "wikitext-fmt.checkDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "%command.checkDocument.title%"
      },
      {
        "command": "wikitext-fmt.previewDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "%command.previewDocument.title%"
      },
      {
        "command": "wikitext-fmt.showLastReport",
        "title": "%command.showLastReport.title%"
      },
      {
        "command": "wikitext-fmt.showResolvedConfiguration",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "%command.showResolvedConfiguration.title%"
      },
      {
        "command": "wikitext-fmt.openConfiguration",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "%command.openConfiguration.title%"
      }
    ],
    "configuration": {
      "properties": {
        "wikitextFmt.behaviorSwitchPlacement": {
          "default": "preserve",
          "description": "%configuration.behaviorSwitchPlacement.description%",
          "enum": [
            "preserve",
            "footer"
          ],
          "enumDescriptions": [
            "%configuration.behaviorSwitchPlacement.enumDescriptions.preserve%",
            "%configuration.behaviorSwitchPlacement.enumDescriptions.footer%"
          ],
          "type": "string"
        },
        "wikitextFmt.config.enabled": {
          "default": true,
          "description": "%configuration.config.enabled.description%",
          "type": "boolean"
        },
        "wikitextFmt.config.path": {
          "default": null,
          "description": "%configuration.config.path.description%",
          "type": [
            "string",
            "null"
          ]
        },
        "wikitextFmt.formatBehaviorSwitches": {
          "default": true,
          "description": "%configuration.formatBehaviorSwitches.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatCategories": {
          "default": true,
          "description": "%configuration.formatCategories.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatExternalLinks": {
          "default": false,
          "description": "%configuration.formatExternalLinks.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatFileLinks": {
          "default": true,
          "description": "%configuration.formatFileLinks.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatHeadings": {
          "default": true,
          "description": "%configuration.formatHeadings.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatInterlanguageLinks": {
          "default": false,
          "description": "%configuration.formatInterlanguageLinks.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatLists": {
          "default": true,
          "description": "%configuration.formatLists.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatRedirects": {
          "default": true,
          "description": "%configuration.formatRedirects.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatReferences": {
          "default": false,
          "description": "%configuration.formatReferences.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatSectionSpacing": {
          "default": false,
          "description": "%configuration.formatSectionSpacing.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatTables": {
          "default": true,
          "description": "%configuration.formatTables.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatTemplateParameters": {
          "default": false,
          "deprecationMessage": "%configuration.formatTemplateParameters.deprecationMessage%",
          "description": "%configuration.formatTemplateParameters.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatTemplates": {
          "default": true,
          "description": "%configuration.formatTemplates.description%",
          "type": "boolean"
        },
        "wikitextFmt.formatWikilinks": {
          "default": true,
          "description": "%configuration.formatWikilinks.description%",
          "type": "boolean"
        },
        "wikitextFmt.htmlVoidTagStyle": {
          "default": "html5",
          "description": "%configuration.htmlVoidTagStyle.description%",
          "enum": [
            "html5",
            "xhtml",
            "preserve"
          ],
          "enumDescriptions": [
            "%configuration.htmlVoidTagStyle.enumDescriptions.html5%",
            "%configuration.htmlVoidTagStyle.enumDescriptions.xhtml%",
            "%configuration.htmlVoidTagStyle.enumDescriptions.preserve%"
          ],
          "type": "string"
        },
        "wikitextFmt.inlineTemplateSpacing": {
          "default": "auto",
          "description": "%configuration.inlineTemplateSpacing.description%",
          "enum": [
            "auto",
            "compact",
            "spaced"
          ],
          "enumDescriptions": [
            "%configuration.inlineTemplateSpacing.enumDescriptions.auto%",
            "%configuration.inlineTemplateSpacing.enumDescriptions.compact%",
            "%configuration.inlineTemplateSpacing.enumDescriptions.spaced%"
          ],
          "type": "string"
        },
        "wikitextFmt.interlanguagePlacement": {
          "default": "preserve",
          "description": "%configuration.interlanguagePlacement.description%",
          "enum": [
            "preserve",
            "footer"
          ],
          "enumDescriptions": [
            "%configuration.interlanguagePlacement.enumDescriptions.preserve%",
            "%configuration.interlanguagePlacement.enumDescriptions.footer%"
          ],
          "type": "string"
        },
        "wikitextFmt.interlanguagePrefixes": {
          "default": [
            "ar",
            "de",
            "en",
            "es",
            "fr",
            "it",
            "ja",
            "ko",
            "pl",
            "pt",
            "ru",
            "uk",
            "zh",
            "zh-hans",
            "zh-hant"
          ],
          "description": "%configuration.interlanguagePrefixes.description%",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "wikitextFmt.level": {
          "default": "normal",
          "description": "%configuration.level.description%",
          "enum": [
            "safe",
            "normal",
            "experimental"
          ],
          "enumDescriptions": [
            "%configuration.level.enumDescriptions.safe%",
            "%configuration.level.enumDescriptions.normal%",
            "%configuration.level.enumDescriptions.experimental%"
          ],
          "type": "string"
        },
        "wikitextFmt.lineWidth": {
          "default": 120,
          "description": "%configuration.lineWidth.description%",
          "type": "number"
        },
        "wikitextFmt.localizedSyntaxStyle": {
          "default": "preserve",
          "description": "%configuration.localizedSyntaxStyle.description%",
          "enum": [
            "preserve",
            "canonical-english"
          ],
          "enumDescriptions": [
            "%configuration.localizedSyntaxStyle.enumDescriptions.preserve%",
            "%configuration.localizedSyntaxStyle.enumDescriptions.canonical-english%"
          ],
          "type": "string"
        },
        "wikitextFmt.normalizeBlankLines": {
          "default": true,
          "description": "%configuration.normalizeBlankLines.description%",
          "type": "boolean"
        },
        "wikitextFmt.profile": {
          "default": "default",
          "description": "%configuration.profile.description%",
          "enum": [
            "default",
            "production",
            "aggressive"
          ],
          "enumDescriptions": [
            "%configuration.profile.enumDescriptions.default%",
            "%configuration.profile.enumDescriptions.production%",
            "%configuration.profile.enumDescriptions.aggressive%"
          ],
          "type": "string"
        },
        "wikitextFmt.safe": {
          "default": true,
          "description": "%configuration.safe.description%",
          "type": "boolean"
        },
        "wikitextFmt.tableCellSeparatorStyle": {
          "default": "auto",
          "description": "%configuration.tableCellSeparatorStyle.description%",
          "enum": [
            "auto",
            "split",
            "preserve"
          ],
          "enumDescriptions": [
            "%configuration.tableCellSeparatorStyle.enumDescriptions.auto%",
            "%configuration.tableCellSeparatorStyle.enumDescriptions.split%",
            "%configuration.tableCellSeparatorStyle.enumDescriptions.preserve%"
          ],
          "type": "string"
        },
        "wikitextFmt.templateParameterLayout": {
          "default": "flush",
          "description": "%configuration.templateParameterLayout.description%",
          "enum": [
            "compact",
            "flush",
            "indented"
          ],
          "enumDescriptions": [
            "%configuration.templateParameterLayout.enumDescriptions.compact%",
            "%configuration.templateParameterLayout.enumDescriptions.flush%",
            "%configuration.templateParameterLayout.enumDescriptions.indented%"
          ],
          "type": "string"
        }
      },
      "title": "%configuration.title%"
    },
    "languages": [
      {
        "aliases": [
          "Wikitext",
          "wikitext",
          "MediaWiki"
        ],
        "extensions": [
          ".wiki",
          ".wikitext",
          ".mediawiki"
        ],
        "id": "wikitext"
      }
    ]
  },
  "dependencies": {
    "wikitext-fmt": "workspace:*"
  },
  "description": "%description%",
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "displayName": "%displayName%",
  "engines": {
    "vscode": "^1.100.0"
  },
  "galleryBanner": {
    "color": "#2f3340",
    "theme": "dark"
  },
  "homepage": "https://github.com/SkyEye-FAST/wikitext-fmt#readme",
  "icon": "images/icon.png",
  "keywords": [
    "wikitext",
    "mediawiki",
    "wiki",
    "formatter",
    "formatting"
  ],
  "l10n": "./l10n",
  "license": "GPL-3.0-or-later",
  "main": "./dist/extension.js",
  "name": "wikitext-formatter",
  "pricing": "Free",
  "publisher": "skyeyefast",
  "qna": false,
  "repository": {
    "directory": "packages/vscode",
    "type": "git",
    "url": "https://github.com/SkyEye-FAST/wikitext-fmt.git"
  },
  "scripts": {
    "build": "pnpm --filter wikitext-fmt build && node scripts/build.mjs",
    "build:tests": "tsc -p tsconfig.test.json && node scripts/prepare-test-output.mjs",
    "check:package-content": "node scripts/check-package-content.mjs",
    "check:release": "pnpm typecheck && pnpm build && pnpm test && pnpm check:package-content && pnpm vscode:package",
    "package": "pnpm vscode:package",
    "test": "vitest run",
    "test:extension": "pnpm build && pnpm build:tests && node dist-test/test/runTest.js",
    "test:vsix": "pnpm vscode:package && pnpm test:vsix:existing",
    "test:vsix:existing": "pnpm build:tests && node scripts/test-vsix.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:package": "pnpm build && vsce package --no-dependencies"
  },
  "type": "module",
  "version": "0.3.0"
}
