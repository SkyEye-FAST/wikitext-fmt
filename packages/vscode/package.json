{
  "activationEvents": [
    "onLanguage:wikitext",
    "onLanguage:mediawiki"
  ],
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "wikitext",
    "mediawiki",
    "wiki",
    "formatter",
    "formatting"
  ],
  "qna": false,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#2f3340",
    "theme": "dark"
  },
  "contributes": {
    "commands": [
      {
        "command": "wikitext-fmt.formatDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "Wikitext Formatter: Format Document"
      },
      {
        "command": "wikitext-fmt.checkDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "Wikitext Formatter: Check Document"
      },
      {
        "command": "wikitext-fmt.previewDocument",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "Wikitext Formatter: Preview Document"
      },
      {
        "command": "wikitext-fmt.showLastReport",
        "title": "Wikitext Formatter: Show Last Report"
      },
      {
        "command": "wikitext-fmt.showResolvedConfiguration",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "Wikitext Formatter: Show Resolved Configuration"
      },
      {
        "command": "wikitext-fmt.openConfiguration",
        "enablement": "editorLangId == wikitext || editorLangId == mediawiki",
        "title": "Wikitext Formatter: Open Configuration"
      }
    ],
    "configuration": {
      "properties": {
        "wikitextFmt.profile": {
          "default": "default",
          "description": "Formatter profile. Production enables graduated structural rules; aggressive also enables still-validating extensions.",
          "enum": [
            "default",
            "production",
            "aggressive"
          ],
          "type": "string"
        },
        "wikitextFmt.lineWidth": {
          "default": 120,
          "description": "Preferred line width used by parser-assisted layout decisions.",
          "type": "number"
        },
        "wikitextFmt.formatHeadings": {
          "default": true,
          "description": "Enable heading formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatTemplates": {
          "default": true,
          "description": "Enable the unified parser-assisted template formatter.",
          "type": "boolean"
        },
        "wikitextFmt.inlineTemplateSpacing": {
          "default": "auto",
          "description": "Canonical spacing for single-line named templates.",
          "enum": [
            "auto",
            "compact",
            "spaced"
          ],
          "type": "string"
        },
        "wikitextFmt.templateParameterLayout": {
          "default": "flush",
          "description": "Parameter layout for multiline templates.",
          "enum": [
            "compact",
            "flush",
            "indented"
          ],
          "type": "string"
        },
        "wikitextFmt.formatTemplateParameters": {
          "default": false,
          "deprecationMessage": "Compatibility entry point for the unified template engine. Use wikitextFmt.formatTemplates, wikitextFmt.templateParameterLayout, and wikitextFmt.inlineTemplateSpacing instead.",
          "description": "Deprecated compatibility alias for the unified template engine.",
          "type": "boolean"
        },
        "wikitextFmt.formatCategories": {
          "default": true,
          "description": "Enable parser-assisted category and DEFAULTSORT footer formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatLists": {
          "default": true,
          "description": "Enable list-marker formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatFileLinks": {
          "default": true,
          "description": "Enable parser-assisted whole-line file link formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatWikilinks": {
          "default": true,
          "description": "Normalize parser-confirmed internal page-link targets to use spaces instead of underscores.",
          "type": "boolean"
        },
        "wikitextFmt.formatExternalLinks": {
          "default": false,
          "description": "Enable experimental external link formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatReferences": {
          "default": false,
          "description": "Enable experimental reference formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatInterlanguageLinks": {
          "default": false,
          "description": "Enable experimental whole-line interlanguage link formatting.",
          "type": "boolean"
        },
        "wikitextFmt.interlanguagePlacement": {
          "default": "preserve",
          "description": "Placement policy for recognized interlanguage links.",
          "enum": [
            "preserve",
            "footer"
          ],
          "type": "string"
        },
        "wikitextFmt.interlanguagePrefixes": {
          "default": [
            "ar",
            "de",
            "en",
            "es",
            "fr",
            "it",
            "ja",
            "ko",
            "pl",
            "pt",
            "ru",
            "uk",
            "zh",
            "zh-hans",
            "zh-hant"
          ],
          "description": "Prefixes recognized as interlanguage links.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "wikitextFmt.formatSectionSpacing": {
          "default": false,
          "description": "Enable experimental section spacing formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatBehaviorSwitches": {
          "default": true,
          "description": "Enable recognized behavior-switch formatting.",
          "type": "boolean"
        },
        "wikitextFmt.formatRedirects": {
          "default": true,
          "description": "Enable parser-assisted redirect formatting.",
          "type": "boolean"
        },
        "wikitextFmt.behaviorSwitchPlacement": {
          "default": "preserve",
          "description": "Placement policy for recognized behavior switches.",
          "enum": [
            "preserve",
            "footer"
          ],
          "type": "string"
        },
        "wikitextFmt.localizedSyntaxStyle": {
          "default": "preserve",
          "description": "Whether recognized localized syntax spelling is preserved or canonicalized to English.",
          "enum": [
            "preserve",
            "canonical-english"
          ],
          "type": "string"
        },
        "wikitextFmt.formatTables": {
          "default": true,
          "description": "Enable normal-level parser-assisted table formatting.",
          "type": "boolean"
        },
        "wikitextFmt.tableCellSeparatorStyle": {
          "default": "auto",
          "description": "Table cell separator layout policy.",
          "enum": [
            "auto",
            "split",
            "preserve"
          ],
          "type": "string"
        },
        "wikitextFmt.normalizeBlankLines": {
          "default": true,
          "description": "Normalize conservative blank-line runs outside protected syntax.",
          "type": "boolean"
        },
        "wikitextFmt.level": {
          "default": "normal",
          "description": "Formatter rule level.",
          "enum": [
            "safe",
            "normal",
            "experimental"
          ],
          "type": "string"
        },
        "wikitextFmt.htmlVoidTagStyle": {
          "default": "html5",
          "description": "HTML void tag style.",
          "enum": [
            "html5",
            "xhtml",
            "preserve"
          ],
          "type": "string"
        },
        "wikitextFmt.safe": {
          "default": true,
          "description": "Run an additional detailed idempotency pass after the formatter's normal parse, round-trip, and structural-equivalence checks.",
          "type": "boolean"
        },
        "wikitextFmt.config.enabled": {
          "default": true,
          "description": "Load wikitext-fmt configuration files for workspace/file documents.",
          "type": "boolean"
        },
        "wikitextFmt.config.path": {
          "default": null,
          "description": "Explicit wikitext-fmt configuration file path. Relative paths are resolved from the workspace folder when available.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "Wikitext Formatter"
    },
    "languages": [
      {
        "aliases": [
          "Wikitext",
          "wikitext",
          "MediaWiki"
        ],
        "extensions": [
          ".wiki",
          ".wikitext",
          ".mediawiki"
        ],
        "id": "wikitext"
      }
    ]
  },
  "dependencies": {
    "wikitext-fmt": "workspace:*"
  },
  "description": "Parser-assisted structural MediaWiki wikitext formatter for VS Code",
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "displayName": "Wikitext Formatter",
  "engines": {
    "vscode": "^1.100.0"
  },
  "icon": "images/icon.png",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/SkyEye-FAST/wikitext-fmt/issues"
  },
  "homepage": "https://github.com/SkyEye-FAST/wikitext-fmt#readme",
  "main": "./dist/extension.js",
  "name": "wikitext-formatter",
  "publisher": "skyeyefast",
  "repository": {
    "type": "git",
    "url": "https://github.com/SkyEye-FAST/wikitext-fmt.git",
    "directory": "packages/vscode"
  },
  "scripts": {
    "build": "pnpm --filter wikitext-fmt build && node scripts/build.mjs",
    "build:tests": "tsc -p tsconfig.test.json && node scripts/prepare-test-output.mjs",
    "check:package-content": "node scripts/check-package-content.mjs",
    "check:release": "pnpm typecheck && pnpm build && pnpm test && pnpm check:package-content && pnpm vscode:package",
    "package": "pnpm vscode:package",
    "test": "vitest run",
    "test:extension": "pnpm build && pnpm build:tests && node dist-test/test/runTest.js",
    "test:vsix": "pnpm vscode:package && pnpm test:vsix:existing",
    "test:vsix:existing": "pnpm build:tests && node scripts/test-vsix.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:package": "pnpm build && vsce package --no-dependencies"
  },
  "type": "module",
  "version": "0.3.0"
}
